# Fabric — variables d'environnement.
#
# En production ces valeurs viennent d'AWS SSM `/fabric/prod` et sont écrites
# dans /run/fabric/.env par le oneshot fabric-env-fetch (voir deploy/ONBOARDING.md).
# Les noms sont "nus", conformément à la convention de la flotte (OPERATIONS.md §3.14).

# --- Backend ---
STATE=DEV                    # PROD ou DEV : sélecteur d'environnement de la flotte
DEBUG=true                   # par défaut : true hors STATE=PROD
SECRET_KEY=                  # OBLIGATOIRE dès que DEBUG est faux
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=http://127.0.0.1:4200,http://localhost:4200
FRONTEND_BASE_URL=http://127.0.0.1:4200
LOG_LEVEL=INFO

# Redis : OBLIGATOIRE dès que DEBUG est faux — la couche mémoire ne transporte
# pas les commandes entre processus. Fabric utilise la DB 5 sur la box.
REDIS_URL=

# Base de données : convention DB_* 6 variables (OPERATIONS.md §3.13).
# Sans DB_ENGINE, Fabric utilise SQLite (développement et tests).
DB_ENGINE=
DB_NAME=fabric
DB_USER=fabric
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Sécurité
THROTTLE_LOGIN=10/hour       # le login est la seule barrière devant un RCE
FABRIC_TOKEN_TTL_HOURS=168   # 0 désactive l'expiration des tokens

# Délai de grâce avant qu'une commande sans réponse soit déclarée expirée.
FABRIC_COMMAND_GRACE_SECONDS=30

# Sentry (optionnel en local). Types SSM : String — un DSN part dans le bundle,
# le mettre en SecureString serait une fausse sécurité (OPERATIONS.md §3.14).
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0
# Frontend : substitué dans index.html au déploiement (deploy/ssm-remote.sh),
# pas injecté à l'exécution — le vhost unique n'a pas de sub_filter.
SENTRY_FRONTEND_DSN=
SENTRY_FRONTEND_ENV=PROD

# --- Agent (sur le PC Windows) ---
FABRIC_SERVER_WS_URL=ws://127.0.0.1:8000/ws/v1/agent/
FABRIC_AGENT_ID=
FABRIC_AGENT_TOKEN=
FABRIC_AGENT_HEARTBEAT_SECONDS=10
FABRIC_CLAUDE_CODE_EXECUTABLE=claude
FABRIC_LOG_LEVEL=INFO

# Watchdog de connectivité
FABRIC_CONNECTIVITY_CHECK_SECONDS=5
FABRIC_CONNECTIVITY_FAILURE_THRESHOLD=3
# La reprise réseau peut désactiver puis réactiver une carte. Désactivée par défaut.
FABRIC_NETWORK_RECOVERY_ENABLED=false
FABRIC_NETWORK_RECOVERY_COOLDOWN_SECONDS=300
FABRIC_NETWORK_RECOVERY_ADAPTER_NAME=
