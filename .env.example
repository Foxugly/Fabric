# Backend
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Required when Fabric is served over HTTPS behind a proxy, e.g.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://fabric.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
FABRIC_CORS_ALLOWED_ORIGINS=http://127.0.0.1:4200,http://localhost:4200
FABRIC_LOG_LEVEL=INFO
# Extra delay before a silent command is declared timed out.
FABRIC_COMMAND_GRACE_SECONDS=30

# Database: PostgreSQL when FABRIC_DB_HOST is set, SQLite otherwise.
FABRIC_DB_NAME=fabric
FABRIC_DB_USER=fabric
FABRIC_DB_PASSWORD=fabric
FABRIC_DB_HOST=127.0.0.1
FABRIC_DB_PORT=5432

# Redis is required as soon as the backend runs more than one process.
FABRIC_REDIS_URL=redis://127.0.0.1:6379/0

# Agent
FABRIC_SERVER_WS_URL=ws://127.0.0.1:8000/ws/v1/agent/
FABRIC_AGENT_ID=
FABRIC_AGENT_TOKEN=
FABRIC_AGENT_HEARTBEAT_SECONDS=10
# Override the Claude Code executable looked up on PATH.
FABRIC_CLAUDE_CODE_EXECUTABLE=claude

# Connectivity watchdog
FABRIC_CONNECTIVITY_CHECK_SECONDS=5
FABRIC_CONNECTIVITY_FAILURE_THRESHOLD=3
# Network self-heal can disable and re-enable a network adapter. Off by default.
FABRIC_NETWORK_RECOVERY_ENABLED=false
FABRIC_NETWORK_RECOVERY_COOLDOWN_SECONDS=300
FABRIC_NETWORK_RECOVERY_ADAPTER_NAME=
